{
  "name": "cenaresses-website",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://CENARESSES.github.io/cenaresses/",
  "dependencies": {
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind-source.css -o ./src/index.css --minify",
    "prestart": "npm run build:css",
    "start": "react-scripts start",
    "prebuild": "npm run build:css",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "gh-pages": "^5.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  }
}
